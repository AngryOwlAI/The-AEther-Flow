    {
      "check_id": "O_INEXACT_CYCLE_EDGE_DELETION",
      "operation_class": "coarse_graining",
      "before_pair": ["C3_TRIANGLE", "C4_SQUARE"],
      "after_pair": ["P3_PATH", "C4_SQUARE"],
      "exact_admissible": false,
      "expected_preserves_relation": false,
      "interpretation": "Arbitrary edge deletion changes beta_1 and is excluded from exact congruence."
    },
    {
      "check_id": "O_INEXACT_CYCLE_COLLAPSE",
      "operation_class": "coarse_graining",
      "before_pair": ["C3_TRIANGLE", "C4_SQUARE"],
      "after_pair": ["POINT", "C4_SQUARE"],
      "exact_admissible": false,
      "expected_preserves_relation": false,
      "interpretation": "Collapsing a cycle to a point shows that coarse graining does not preserve this relation automatically."
    }
  ],
