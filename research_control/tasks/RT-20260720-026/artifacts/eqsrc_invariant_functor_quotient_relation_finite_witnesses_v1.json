      "exact_admissible": true,
      "expected_preserves_relation": true,
      "interpretation": "Subdividing one cycle edge preserves graph homology."
    },
    {
      "check_id": "O_COARSE_GRAINING_BRIDGE_CONTRACTION",
      "operation_class": "coarse_graining",
      "before_pair": ["TRIANGLE_WITH_TAIL", "C3_TRIANGLE"],
      "after_pair": ["C3_TRIANGLE", "C3_TRIANGLE"],
      "exact_admissible": true,
      "expected_preserves_relation": true,
      "interpretation": "Contracting the declared bridge preserves the Betti pair."
    },
    {
      "check_id": "O_VARIATION_RELABELING",
      "operation_class": "variation",
      "before_pair": ["C3_TRIANGLE", "C4_SQUARE"],
      "after_pair": ["C3_RELABELED", "C4_SQUARE"],
      "exact_admissible": true,
      "expected_preserves_relation": true,
      "interpretation": "A source relabeling is an isomorphism and preserves H."
