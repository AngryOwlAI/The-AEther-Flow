        {"observable_id": "root_label", "source_side_definition": "label of the chosen source root", "values": [0, 1, 2, 3], "expected_class": "representative_sensitive"},
        {"observable_id": "distance_to_fixed_v0", "source_side_definition": "graph distance from the chosen root to source vertex v0", "values": [0, 1, 2, 1], "expected_class": "representative_sensitive"}
