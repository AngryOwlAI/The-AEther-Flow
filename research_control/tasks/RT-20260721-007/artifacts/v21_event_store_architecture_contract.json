  "architecture_options": [
    {
      "id": "tracked_jsonl_only",
      "selected": false,
      "canonical_write_model": "append_only_tracked_jsonl",
      "query_model": "full_replay_or_generated_flat_views",
      "strengths": [
        "human-reviewable Git diffs",
        "portable content hashes",
        "simple historical recovery"
      ],
      "risks": [
        "slow ad hoc joins at scale",
        "every consumer must implement replay semantics"
      ],
      "disposition": "not_selected_because_query_index_is_needed"
    },
    {
      "id": "sqlite_only",
      "selected": false,
      "canonical_write_model": "sqlite_transactions",
      "query_model": "indexed_relational_queries",
      "strengths": [
        "strong local transactions",
        "fast joins and aggregate queries"
      ],
      "risks": [
        "binary diffs are not reviewable",
        "merge and historical readability are poor in Git",
        "database files invite accidental authority ambiguity"
      ],
      "disposition": "rejected_as_canonical_tracked_format"
    },
    {
      "id": "hybrid_tracked_jsonl_plus_generated_sqlite",
      "selected": true,
      "canonical_write_model": "append_only_tracked_jsonl_after_explicit_future_cutover",
      "query_model": "deterministic_generated_sqlite_and_flat_views",
      "strengths": [
        "reviewable portable canonical history",
        "fast disposable local queries",
        "deterministic CSV and Markdown compatibility views",
        "clean rollback to tracked legacy sources"
      ],
      "risks": [
        "requires parity validation between replay and projections",
        "requires an explicit single-writer transaction protocol"
      ],
      "disposition": "selected_for_future_pilot_and_separately_authorized_cutover"
    }
  ],
