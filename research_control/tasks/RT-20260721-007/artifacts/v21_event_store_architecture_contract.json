    "operation_id_rule": "Producer-supplied stable idempotency key unique within the subject and event type.",
    "sequence_rule": "Global sequence is assigned only while holding the writer lock and equals prior manifest last_sequence plus one.",
    "chain_rule": "event_hash is SHA-256 over canonical event content excluding event_hash; prior_event_hash must equal the manifest head hash or GENESIS for sequence one.",
    "duplicate_rule": "An existing event_id with byte-identical content is an idempotent no-op; any differing content is a hard conflict.",
    "correction_rule": "Finalized events are immutable. Corrections are new correction events that reference superseded_event_ids and never rewrite or delete history."
  },
