      "create_one_Git_checkpoint_commit",
      "release_lock"
    ],
    "failure_atomicity": "A failure before checkpoint leaves no authoritative transaction; staged worktree files are diagnostic only and must not be consumed as canonical events.",
    "multi_file_visibility": "Readers accept only a manifest and views from the same committed transaction receipt."
  },
