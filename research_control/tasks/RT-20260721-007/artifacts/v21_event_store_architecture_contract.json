  "projection_contract": {
    "input": "manifest-ordered validated JSONL events",
    "replay_order": ["sequence", "event_id"],
    "latest_state_rule": "Fold events by domain reducer; corrections apply only through explicit supersedes references.",
    "determinism_rule": "Same manifest hash and renderer version must produce byte-identical tracked views.",
    "provenance_rule": "Every generated view carries or has an adjacent receipt containing manifest hash renderer hash row count and output hash.",
    "parity_rule": "Before any cutover, generated legacy-format views must match the authoritative legacy source under a field-level allowlist and report every unmapped field.",
    "failure_rule": "Unknown events hash mismatch sequence gap duplicate conflicting identity projection ambiguity or output drift fail closed and publish no replacement view.",
