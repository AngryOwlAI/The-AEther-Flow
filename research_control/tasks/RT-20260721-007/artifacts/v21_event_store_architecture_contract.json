  "event_identity": {
    "event_schema_id": "v21_project_control_event_v1",
    "event_id_format": "EVT-V21-<sha256_64hex>",
    "event_id_preimage": "RFC8785 canonical JSON of identity_basis",
    "identity_basis_fields": [
